# Environment Configuration
# Set to "development" to use the test webhook, or "production" for the live webhook
VITE_ENVIRONMENT=production

# Optional: Search Console HTML-tag verification token (public, embedded at build time).
# Domain-property verification via a DNS TXT record needs no environment variable.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# n8n Webhook URLs (configured in Contact.tsx)
# Development: https://n8n.yarden-zamir.com/webhook-test/client-contact-form
# Production: https://n8n.yarden-zamir.com/webhook/client-contact-form

