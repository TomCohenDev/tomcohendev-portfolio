---
// The English site (React Router, basename /en). The Worker serves this page for every /en/* path
// (edge/index.ts), and public/_redirects sends the old English URLs (/services, /case-studies/*, ...) here.
import "../index.css";
import EnglishApp from "../EnglishApp";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Consent Mode v2 - Must load BEFORE Google tag -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'analytics_storage': 'granted',
        'ad_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'granted',
        'functionality_storage': 'granted',
        'personalization_storage': 'granted'
      });
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-17859325774"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-17859325774');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tom Cohen</title>
    <meta
      name="description"
      content="Tom Cohen — developer and product builder. Portfolio, case studies, and services: MVPs, web and mobile apps, AI integrations, and automation."
    />
    <meta name="author" content="Tom Cohen" />
    <meta
      name="keywords"
      content="Tom Cohen, developer, portfolio, MVP, web development, mobile apps, AI integration, automation, product studio"
    />
    <meta property="og:title" content="Tom Cohen" />
    <meta
      property="og:description"
      content="Developer and product builder. MVPs, web and mobile apps, AI integrations, and automation — explore the portfolio and case studies."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tomcohen.dev/en" />
    <meta property="og:image" content="https://tomcohendev.com/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Tom Cohen" />
    <meta
      name="twitter:description"
      content="Developer and product builder. MVPs, web and mobile apps, AI integrations, and automation."
    />
    <meta name="twitter:image" content="https://tomcohendev.com/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icon.svg?v=2" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/icon.svg?v=2" />
    <link rel="canonical" href="https://tomcohen.dev/en" />
  </head>
  <body>
    <div id="root">
      <EnglishApp client:only="react" />
    </div>
  </body>
</html>
