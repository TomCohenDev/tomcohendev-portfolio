---
import HebrewLayout from "../../layouts/HebrewLayout.astro";
import NewsIssue, { DESCRIPTION } from "../../views/NewsIssue";
import { DEMO, formatDate, issues, type Issue } from "../../components/content/mock";

// Every issue but the newest, which lives at /news.
export const getStaticPaths = () => issues.slice(1).map((issue) => ({ params: { date: issue.date }, props: { issue } }));
const { issue } = Astro.props as { issue: Issue };
---

<HebrewLayout title={`חדשות הבוקר, ${formatDate(issue.date)} | תום כהן`} description={DESCRIPTION} path={`/news/${issue.date}`} noindex={DEMO}>
  <NewsIssue issue={issue} />
</HebrewLayout>
