---
/**
 * HTML shell of the Hebrew pages: lang and direction, metadata, share tags, fonts, the existing Google tag,
 * and structured data. The page content comes in the slot.
 */
import "../index.css";

interface Props {
  lang?: "he" | "en";
  title: string;
  description: string;
  /** Path of the page, such as "/mobile". Builds the canonical and share URLs. */
  path: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path of the share image in public/. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  twitterTitle?: string;
  twitterDescription?: string;
  jsonLd?: object;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Leave the phone number and email address out of the no-JavaScript note. */
  hideContact?: boolean;
}

const {
  lang = "he",
  title,
  description,
  path,
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og-automation.png",
  ogImageAlt = "תום כהן",
  ogType = "website",
  twitterTitle = title,
  twitterDescription = description,
  jsonLd,
  noindex = false,
  hideContact = false,
} = Astro.props;

const url = new URL(path, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={lang === "he" ? "rtl" : "ltr"}>
  <head>
    <!-- Same Google tag setup as the English site -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      gtag('consent', 'default', {
        'analytics_storage': 'granted',
        'ad_storage': 'granted',
        'ad_user_data': 'granted',
        'ad_personalization': 'granted',
        'functionality_storage': 'granted',
        'personalization_storage': 'granted'
      });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-17859325774"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-17859325774');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1D201F" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={lang === "he" ? "תום כהן" : "Tom Cohen"} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}
    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
    {path === "/" && <>
      <link rel="alternate" hreflang="he" href="https://tomcohen.dev/" />
      <link rel="alternate" hreflang="en" href="https://tomcohen.dev/en" />
      <link rel="alternate" hreflang="x-default" href="https://tomcohen.dev/" />
    </>}

    <meta property="og:locale" content={lang === "he" ? "he_IL" : "en_US"} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={lang === "he" ? "תום כהן" : "Tom Cohen"} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="alternate" type="application/rss+xml" title="תום כהן: מאמרים" href="/blog/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="תום כהן: חדשות הבוקר" href="/news/feed.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Playpen+Sans+Hebrew:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/icon.svg?v=2" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/icon.svg?v=2" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />}
    <slot name="head" />
  </head>

  <body>
    <noscript>
      <p>
        {lang === "he" ? "הטופס בעמוד צריך JavaScript." : "Forms on this page require JavaScript."}
        {!hideContact && (lang === "he" ? "אפשר גם לפנות ישירות: contact@tomcohen.dev או בטלפון 054-555-2149" : "Contact: contact@tomcohen.dev or +972-54-555-2149.")}
      </p>
    </noscript>
    <slot />

    <script>
      // Same PostHog settings as the English site (src/EnglishApp.tsx). Without a key nothing loads,
      // which is the case today: the build has no VITE_PUBLIC_POSTHOG_KEY.
      const key = import.meta.env.VITE_PUBLIC_POSTHOG_KEY;
      if (key) {
        import("posthog-js").then(({ default: posthog }) =>
          posthog.init(key, {
            api_host: import.meta.env.VITE_PUBLIC_POSTHOG_PROXY || import.meta.env.VITE_PUBLIC_POSTHOG_HOST,
            ui_host: import.meta.env.VITE_PUBLIC_POSTHOG_HOST,
            defaults: "2025-11-30",
            capture_exceptions: true,
          })
        );
      }
    </script>
  </body>
</html>
